<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Android only targeting -->
    <TargetFrameworks>net8.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>AntiTheftApp.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>AntiTheftApp</ApplicationTitle>
    <ApplicationId>com.antitheftapp.mobile</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- 26.0 (Android 8.0) is required for Firebase push support -->
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-android'">26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw Assets -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required for MAUI controls in .NET 8 -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.3" />

    <!-- Local unlock PIN hashing -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- Native FCM bindings for Android -->
<PackageReference Include="Xamarin.Firebase.Messaging" Version="123.4.0" Condition="'$(TargetFramework)'=='net8.0-android'" />  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net8.0-android'">
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.2.0.9" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net8.0-android'">
    <!-- Download this from Firebase Console and place it at Platforms/Android/google-services.json -->
    <GoogleServicesJson Include="Platforms\Android\google-services.json" Condition="Exists('Platforms\Android\google-services.json')" />
  </ItemGroup>

</Project>