<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="AntiTheftApp.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="AntiTheftApp">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <Label Text="AntiTheftApp" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Protect this device" FontSize="14" HorizontalOptions="Center" TextColor="Gray" />

            <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" />
            <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />

            <Entry x:Name="PinEntry" Placeholder="Account PIN (new accounts only)" Keyboard="Numeric" MaxLength="8" />

            <Button x:Name="LoginButton" Text="Log In" Clicked="OnLoginClicked" />
            <Button x:Name="RegisterButton" Text="Create Account" Clicked="OnRegisterClicked" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />

            <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
